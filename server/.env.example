# BRT Dost — Server Environment Configuration
# Copy this file to .env and configure appropriate values for your environment.

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or local instance)
# Leave blank to automatically use the embedded in-memory MongoDB fallback for zero-config evaluation
MONGODB_URI=

# Permitted Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_peshawar_brt_2026
SESSION_SECRET=your_super_secret_session_key_peshawar_brt_2026
JWT_EXPIRES_IN=24h

# Administrator Initial Setup Credentials
ADMIN_EMAIL=admin@brtdost.pk
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=AdminBRT2026!

# Trust & Freshness Engine Configuration
# Time in hours before an unconfirmed announcement becomes 'Stale'
DEFAULT_FRESHNESS_HOURS=4

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
